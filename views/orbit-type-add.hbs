<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
<div class="phone">
  <main class="page orbit-add-page">
    <h1>Добавление типа орбиты</h1>
    <p class="draft" id="draft-state" {{#unless draftOrbitType}}hidden{{/unless}}>
      черновик · <strong id="draft-name">{{draftOrbitType.name}}</strong>
    </p>
    <form class="orbit-form" id="orbit-form" data-phase="{{#if draftOrbitType}}publish{{else}}create{{/if}}" method="POST" action="{{#if draftOrbitType}}/orbit-type/publish{{else}}/orbit-type/add{{/if}}" autocomplete="off">
      <label class="upload-field" for="orbit-type-image-file">
        <span class="field-label">Фото</span>
        <span class="upload-box photo-upload">
          <img src="{{#if draftOrbitType}}{{draftOrbitType.image}}{{else}}/media/default-orbit.svg{{/if}}" alt="Фото типа орбиты" onerror="this.onerror=null;this.src='/media/default-orbit.svg'">
          <span class="upload-caption">Выбрать фото</span>
          <input id="orbit-type-image-file" class="file-input" type="file" accept="image/*">
        </span>
      </label>

      <label class="upload-field" for="orbit-type-video-file">
        <span class="field-label">Видео</span>
        <span class="upload-box video-upload">
          <video class="upload-video-preview" src="{{#if draftOrbitType.video}}{{draftOrbitType.video}}{{else}}/media/default-orbit.webm{{/if}}" poster="/media/default-orbit.svg" muted autoplay loop playsinline onerror="this.onerror=null;this.src='/media/default-orbit.webm';this.load()"></video>
          <span class="upload-caption">Выбрать видео</span>
          <input id="orbit-type-video-file" class="file-input" type="file" accept="video/*">
        </span>
      </label>

      <fieldset class="step-fields" id="create-fields" {{#if draftOrbitType}}disabled hidden{{/if}}>
        <label for="orbit-name">Название</label>
        <input id="orbit-name" name="name" type="text" maxlength="120" {{#unless draftOrbitType}}required{{/unless}}>

        <button class="primary-action" type="submit">Далее</button>
      </fieldset>

      <fieldset class="step-fields" id="publish-fields" {{#unless draftOrbitType}}disabled hidden{{/unless}}>
        <label for="orbit-type-description">Краткое описание</label>
        <textarea id="orbit-type-description" name="description" rows="4" maxlength="2000" required>{{draftOrbitType.description}}</textarea>

        <label for="orbit-type-height">Высота</label>
        <div class="input-with-unit">
          <input id="orbit-type-height" name="height" type="number" min="0" max="40000" step="1" value="{{draftOrbitType.height}}" required>
          <span>км</span>
        </div>

        <label for="orbit-type-inclination">Наклонение</label>
        <div class="input-with-unit">
          <input id="orbit-type-inclination" name="inclination" type="number" min="0" max="180" step="0.1" value="{{draftOrbitType.inclination}}" required>
          <span>°</span>
        </div>

        <label for="orbit-type-select">Тип орбиты</label>
        <select id="orbit-type-select" name="orbitCode" required>
          <option value="" disabled {{#unless draftOrbitType.orbitCode}}selected{{/unless}}>Выберите тип</option>
          <option value="LEO" {{#if (eq draftOrbitType.orbitCode "LEO")}}selected{{/if}}>Низкая околоземная</option>
          <option value="GEO" {{#if (eq draftOrbitType.orbitCode "GEO")}}selected{{/if}}>Геостационарная</option>
          <option value="SSO" {{#if (eq draftOrbitType.orbitCode "SSO")}}selected{{/if}}>Солнечно-синхронная</option>
        </select>

        <button class="primary-action" type="submit">Опубликовать</button>
      </fieldset>
      <p class="form-error" id="form-error" role="alert" hidden></p>
    </form>
  </main>

  {{> navigation isAdd=true}}
</div>
<script>
  const form = document.getElementById('orbit-form');
  const createFields = document.getElementById('create-fields');
  const publishFields = document.getElementById('publish-fields');
  const draftState = document.getElementById('draft-state');
  const errorMessage = document.getElementById('form-error');
  const imageInput = document.getElementById('orbit-type-image-file');
  let imagePreviewUrl;
  imageInput.addEventListener('change', () => {
    const file = imageInput.files[0];
    if (!file) return;
    if (imagePreviewUrl) URL.revokeObjectURL(imagePreviewUrl);
    imagePreviewUrl = URL.createObjectURL(file);
    imageInput.closest('.upload-box').querySelector('img').src = imagePreviewUrl;
    imageInput.closest('.upload-box').querySelector('.upload-caption').textContent = file.name;
  });

  const videoInput = document.getElementById('orbit-type-video-file');
  let videoPreviewUrl;
  videoInput.addEventListener('change', () => {
    const file = videoInput.files[0];
    if (!file) return;
    if (videoPreviewUrl) URL.revokeObjectURL(videoPreviewUrl);
    videoPreviewUrl = URL.createObjectURL(file);
    const box = videoInput.closest('.upload-box');
    const preview = box.querySelector('video');
    preview.src = videoPreviewUrl;
    preview.hidden = false;
    box.querySelector('.upload-caption').textContent = file.name;
    preview.play().catch(() => {});
  });

  form.addEventListener('submit', async (event) => {
    if (form.dataset.phase !== 'create') return;
    event.preventDefault();
    if (!form.reportValidity()) return;

    const nextButton = createFields.querySelector('button');
    nextButton.disabled = true;
    errorMessage.hidden = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ name: document.getElementById('orbit-name').value }),
      });
      if (!response.ok) throw new Error('Не удалось создать черновик');

      const nextPage = new DOMParser().parseFromString(await response.text(), 'text/html');
      const savedName = nextPage.getElementById('draft-name')?.textContent?.trim();
      if (!savedName) throw new Error('Не удалось открыть черновик');

      document.getElementById('draft-name').textContent = savedName;
      draftState.hidden = false;
      createFields.disabled = true;
      createFields.hidden = true;
      publishFields.disabled = false;
      publishFields.hidden = false;
      form.action = '/orbit-type/publish';
      form.dataset.phase = 'publish';
    } catch (error) {
      errorMessage.textContent = error.message || 'Не удалось создать черновик';
      errorMessage.hidden = false;
    } finally {
      nextButton.disabled = false;
    }
  });
</script>
</body>
</html>
