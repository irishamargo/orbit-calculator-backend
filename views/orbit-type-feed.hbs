<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="phone">
  <main class="feed-page">
    {{#if orbitType}}
    <section class="feed-card">
      <video
        class="feed-video"
        autoplay
        muted
        loop
        playsinline
        poster="{{orbitType.image}}"
      >
        <source src="{{orbitType.video}}" type="{{orbitType.videoType}}">
      </video>

      <div class="feed-overlay"></div>

      <div class="feed-content">
        <div class="feed-layout">
          <div class="feed-info">
          <h1>{{orbitType.name}}</h1>

          <div class="feed-description-block">
            <p class="feed-description-preview" id="orbit-description-preview">{{orbitType.description}}</p>
            <p class="feed-description" id="orbit-description" hidden>{{orbitType.description}}</p>

            <button
              type="button"
              class="more-button"
              aria-controls="orbit-description"
              aria-expanded="false"
              onclick="toggleOrbitTypeDescription(this)"
            >
              <span class="details-more">Ещё ↓</span>
              <span class="details-less" hidden>Скрыть ↑</span>
            </button>
          </div>
          </div>

          <div class="feed-actions">
            <p class="feed-parameter">Высота<strong>{{orbitType.height}} км</strong></p>
            <p class="feed-parameter">Наклонение<strong>{{orbitType.inclination}}°</strong></p>

            <div class="likes" aria-label="Лайков: {{orbitType.likeCount}}">
                <span class="heart" aria-hidden="true">{{#if orbitType.isLiked}}♥{{else}}♡{{/if}}</span>
                <span class="like-count">{{orbitType.likeCount}}</span>
            </div>

            <a
              href="/?id={{nextOrbitType.id}}"
              class="next-button"
              aria-label="Следующий тип орбиты"
              title="Следующий тип орбиты"
            >→</a>
          </div>
        </div>
      </div>
    </section>
    {{else}}
    <section class="empty-feed">Пока нет опубликованных типов орбит.</section>
    {{/if}}
  </main>

  {{> navigation isHome=true}}
</div>

<script>
  const feedVideo = document.querySelector('.feed-video');
  const videoSource = feedVideo?.querySelector('source');
  function useDefaultVideo() {
    if (!videoSource || new URL(videoSource.src).pathname === '/media/default-orbit.webm') return;
    videoSource.src = '/media/default-orbit.webm';
    videoSource.type = 'video/webm';
    feedVideo.poster = '/media/default-orbit.svg';
    feedVideo.load();
    feedVideo.play().catch(() => {});
  }
  feedVideo?.addEventListener('error', useDefaultVideo);
  videoSource?.addEventListener('error', useDefaultVideo);

  function toggleOrbitTypeDescription(button) {
    const block = button.closest('.feed-description-block');
    const preview = block.querySelector('.feed-description-preview');
    const description = block.querySelector('.feed-description');
    const isExpanded = description.hidden;

    description.hidden = !isExpanded;
    preview.hidden = isExpanded;
    button.querySelector('.details-more').hidden = isExpanded;
    button.querySelector('.details-less').hidden = !isExpanded;
    button.setAttribute('aria-expanded', String(isExpanded));
  }
</script>

</body>

</html>
