<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="phone">

  <main class="page">

    <h1>Добавление расчёта</h1>

    <p class="draft">черновик</p>

    <form>

      <label for="name">
        Название спутника
      </label>

      <input
        id="name"
        name="name"
        type="text"
        placeholder="Например, Sfera"
        value="{{draftCalculation.name}}"
      >

      <label for="orbitType">
        Тип орбиты
      </label>

      <select id="orbitType" name="orbitType">

        <option value="LEO">
          Низкая околоземная
        </option>

        <option value="GEO">
          Геостационарная
        </option>

        <option value="SSO" selected>
          Солнечно-синхронная
        </option>

      </select>

      <label for="mass">
        Масса
      </label>

      <div class="input-with-unit">

        <input
          id="mass"
          name="mass"
          type="number"
          placeholder="750"
          value="{{draftCalculation.mass}}"
          min="0"
        >

        <span>кг</span>

      </div>

      <label>
        Фото
      </label>

      <div
        class="upload-box photo-preview"
        style="background-image: url('{{draftCalculation.image}}')"
        aria-label="Фото {{draftCalculation.name}}"
      >
      </div>

      <label>
        Видео
      </label>

      <div class="upload-box video-box">
        <span>+</span>
      </div>

      <button type="button" class="primary-button add-button">
        Добавить
      </button>

    </form>

  </main>

  {{> navigation isAdd=true}}

</div>

</body>

</html>
